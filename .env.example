HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/data/app.sqlite
STATIC_ROOT=dist/client
COOKIE_SECURE=true
# Required for an interactive production first run; use at least 32 unique characters.
ISHIKU_SETUP_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
# Alternative unattended bootstrap. The file must contain a unique password of at least 12 characters.
# ISHIKU_BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap_password
